{
  "id": "bmwcaminfo-voice",
  "kind": "tool",
  "version": "0.1.10",
  "license": "MIT",
  "title": "BMW Camera Voice Service",
  "description": "Russian camera warnings with model-specific Strelka and Avtodoria speech and previous audio route restoration",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "voice.js",
      "from": "voice.js",
      "mode": "0644"
    },
    {
      "path": "audio-manifest.json",
      "from": "audio-manifest.json",
      "mode": "0644"
    },
    {
      "path": "audio/avtodoria-200.m4a",
      "from": "audio/avtodoria-200.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/avtodoria-average-200.m4a",
      "from": "audio/avtodoria-average-200.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/avtodoria-average.m4a",
      "from": "audio/avtodoria-average.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/avtodoria.m4a",
      "from": "audio/avtodoria.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/camera-200.m4a",
      "from": "audio/camera-200.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/camera-500.m4a",
      "from": "audio/camera-500.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/strelka-200.m4a",
      "from": "audio/strelka-200.m4a",
      "mode": "0644"
    },
    {
      "path": "audio/strelka.m4a",
      "from": "audio/strelka.m4a",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bmwcaminfo-voice.service",
      "from": "systemd/bmwcaminfo-voice.service"
    }
  ],
  "enable": [
    {
      "unit": "bmwcaminfo-voice.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "bmwcaminfo-voice.service"
  ],
  "crashNames": [
    "bmwcaminfo-voice"
  ]
}
