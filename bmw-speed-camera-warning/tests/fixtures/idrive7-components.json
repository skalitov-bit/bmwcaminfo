{
  "source": "https://github.com/cauliflowermossgrape/idrive7-apps",
  "checkedOn": "2026-11-15",
  "components": [
    {
      "id": "idrive7-renderd",
      "kind": "tool",
      "version": "2.1.18",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "optional": true,
      "uninstallable": true,
      "requires": {
        "mgu-deploy": "0.6.1"
      },
      "files": [
        {
          "path": "mgu-renderd",
          "mode": "0755"
        },
        {
          "path": "foreground_gate.js",
          "mode": "0644"
        },
        {
          "path": "hmi_template.js",
          "mode": "0644"
        },
        {
          "path": "mgu-render-hmi.sh",
          "mode": "0644"
        },
        {
          "path": "mgu-render-hmi-guard.sh",
          "mode": "0644"
        },
        {
          "path": "idrive7-renderd-install.sh",
          "mode": "0644"
        },
        {
          "path": "LICENSE",
          "mode": "0644"
        },
        {
          "path": "LICENSE.mgu-renderd",
          "mode": "0644"
        }
      ],
      "units": [
        {
          "name": "idrive7-renderd.service"
        },
        {
          "name": "idrive7-renderd-hmi.service"
        }
      ],
      "enable": [
        {
          "unit": "idrive7-renderd.service",
          "target": "oapcontroller.service"
        },
        {
          "unit": "idrive7-renderd-hmi.service",
          "target": "hmi.service"
        }
      ],
      "dropins": [
        {
          "unit": "display-bridge.socket",
          "name": "idrive7-renderd.conf",
          "from": "display-bridge-standdown.conf"
        },
        {
          "unit": "display-bridge.service",
          "name": "idrive7-renderd.conf",
          "from": "display-bridge-standdown.conf"
        },
        {
          "unit": "display-bridge-hmi.service",
          "name": "idrive7-renderd.conf",
          "from": "display-bridge-standdown.conf"
        }
      ],
      "recmgr": [
        "idrive7-renderd",
        "idrive7-renderd-hmi"
      ],
      "restart": [
        "idrive7-renderd.service"
      ],
      "keepRunning": true,
      "postInstall": [
        "idrive7-renderd-install.sh"
      ]
    },
    {
      "id": "mgu-inputgate",
      "kind": "tool",
      "version": "1.1.0",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "files": [
        {
          "path": "mgu-inputgate.so",
          "mode": "0755"
        },
        {
          "path": "guard.sh",
          "mode": "0755"
        }
      ],
      "units": [
        {
          "name": "mgu-inputgate-guard.service"
        },
        {
          "name": "mgu-inputgate-check.service"
        }
      ],
      "dropins": [
        {
          "unit": "hmi.service",
          "name": "zz-mgu-inputgate.conf"
        },
        {
          "unit": "hmi8.service",
          "name": "zz-mgu-inputgate.conf"
        }
      ],
      "enable": [],
      "recmgr": [],
      "restart": []
    }
  ]
}
